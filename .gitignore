# Artefactos transitorios (NO se versionan)
.workspace/
results/**/manifest.jsonl.tmp

# Python
__pycache__/
*.pyc
.venv/

# Secretos — el control real es el escaneo pre-push (grep de tokens reales).
# NO se ignoran patrones de nombres: los repos upstream legítimos contienen "token"
# en su nombre (p.ej. huami-token) y su contenido ya es público en GitHub.
.env
.secrets/

# OS
.DS_Store

# Manifiestos grandes: en partes (GitHub limita 100MB/archivo)
results/full-1/manifest.jsonl
